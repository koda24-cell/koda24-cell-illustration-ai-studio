{
  "job_id": "artcraft-studio-handoff-smoke",
  "title": "ArtCraft 公開受け渡し検証",
  "backend": "procedural",
  "time_budget_minutes": 5.0,
  "publish": true,
  "limits": {
    "max_rounds": 1,
    "candidates_per_round": 1,
    "patience": 2,
    "target_score": 0.8,
    "max_error_retries": 3
  },
  "defaults": {
    "width": 128,
    "height": 128,
    "steps": 6,
    "cfg": 7,
    "scheduler": "euler_a",
    "negative_prompt": "",
    "denoise": 0.5
  },
  "evaluation": {
    "metrics": [
      "composition",
      "artifacts"
    ]
  },
  "stages": [
    {
      "name": "colored",
      "op": "txt2img",
      "prompt": "public colored geometric test pattern"
    }
  ],
  "improve": {
    "enabled": true,
    "tune": [
      "cfg",
      "steps",
      "denoise",
      "prompt"
    ]
  }
}
